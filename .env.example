# Copier ce fichier en .env et remplacer TOUTES les valeurs « a-changer ».
# Le fichier .env contient des secrets : il ne doit jamais être versionné (voir .gitignore).
# Mots de passe : éviter les apostrophes et les caractères $ (interprétés par Compose).

# Version des images construites
APP_VERSION=0.1.0
# Port publié du frontend (seul point d'entrée)
FRONTEND_PORT=8080

# Base de données
DB_NAME=bibliotheque
MARIADB_ROOT_PASSWORD=a-changer-root
# Utilisateur de migration (Flyway, propriétaire du schéma, sauvegardes)
DB_MIGRATION_USER=bibliotheque_migration
DB_MIGRATION_PASSWORD=a-changer-migration
# Utilisateur applicatif (SELECT/INSERT/UPDATE/DELETE uniquement)
DB_APP_USER=bibliotheque_app
DB_APP_PASSWORD=a-changer-app

# Administrateur initial, créé au premier démarrage si aucun administrateur n'existe.
# Mot de passe temporaire conforme à RG-01 (≥ 12 caractères, majuscule, minuscule, chiffre),
# à changer à la première connexion (RG-05).
APP_BOOTSTRAP_ADMIN_EMAIL=admin@bibliotheque.example
APP_BOOTSTRAP_ADMIN_PASSWORD=a-changer-Admin2026

# Sauvegardes (NFR-12)
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
